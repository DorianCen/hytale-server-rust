<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.hypixel.hytale.tools</groupId>
    <artifactId>java-dumper</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Hytale golden dumper</name>
    <description>Emits deterministic reference data from the original Java WorldGenerator for the Rust port.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <!-- Java sources are read-only reference material; point at their compiled classes. -->
        <hytale.server.root>${project.basedir}/../../.hytale-source/hytale-shared-source/HytaleServer</hytale.server.root>
        <gson.version>2.13.2</gson.version>
        <joml.version>1.10.8</joml.version>
        <fastutil.version>8.5.12</fastutil.version>
        <sentry.version>8.30.0</sentry.version>
    </properties>

    <dependencies>
        <!--
          run.sh packages the already-compiled upstream class directories into these jars.
          Maven's system scope requires a file, not a directory, hence the jar indirection.
        -->
        <dependency>
            <groupId>com.hypixel.hytale</groupId>
            <artifactId>Math</artifactId>
            <version>0.0.0-dev</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/hytale-Math.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.hypixel.hytale</groupId>
            <artifactId>ProceduralLibrary</artifactId>
            <version>0.0.0-dev</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/hytale-ProceduralLibrary.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.hypixel.hytale</groupId>
            <artifactId>WorldGenerator</artifactId>
            <version>0.0.0-dev</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/hytale-WorldGenerator.jar</systemPath>
        </dependency>

        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>
        <dependency>
            <groupId>org.joml</groupId>
            <artifactId>joml</artifactId>
            <version>${joml.version}</version>
        </dependency>
        <!--
          The upstream ProceduralLibrary/WorldGenerator classes reference fastutil
          (Int2ObjectOpenHashMap, Object2IntOpenHashMap, Hash.Strategy, ...).
          The server vendors a fork of fastutil that itself depends on 8.5.2.
        -->
        <dependency>
            <groupId>it.unimi.dsi</groupId>
            <artifactId>fastutil</artifactId>
            <version>${fastutil.version}</version>
        </dependency>
        <!--
          `procedurallib.json.SeedString` uses `io.sentry.util.Objects` at runtime.
        -->
        <dependency>
            <groupId>io.sentry</groupId>
            <artifactId>sentry</artifactId>
            <version>${sentry.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
            </plugin>
        </plugins>
    </build>
</project>
